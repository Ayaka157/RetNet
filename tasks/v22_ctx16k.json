{
  "_comment": [
    "v22：16K 长上下文扩展（从 v21 的 gamma 重初始化模型起步）",
    "seq_len 16384、batch 2（per-GPU）-> 等效 65,536 token/步，与 v21 同吞吐",
    "为什么不是 32K：32K 只能 batch 1/卡（每步仅 2 条序列），梯度方差大，",
    "0.5B token 的预算下 16K/batch2（4 条）更稳；显存上限本身是 32,768。",
    "--no_decay_1d 必须开，否则 gamma 又会被 weight decay 拉下去"
  ],
  "name": "v22_ctx16k",
  "model_dir": "checkpoints/retnet_500m_v22_init",
  "output_dir": "checkpoints/retnet_500m_v22",
  "plan": "tasks/plan_ctx16k.json",
  "nproc": 2,
  "master_port": 29510,
  "precision": "bf16",
  "mode": "chunkwise",
  "chunk_size": 128,
  "batch_size": 2,
  "grad_accum": 1,
  "dataloader_workers": 0,
  "optim": "adamw_bnb_8bit",
  "grad_checkpoint": false,
  "compile": true,
  "compile_mode": "max-autotune-no-cudagraphs",
  "fast_chunkwise": true,
  "no_decay_1d": true,
  "save_total_limit": 2,
  "seed": 1234,
  "resume": false,
  "auto_restart_max": 0,
  "restart_wait_min": 3
